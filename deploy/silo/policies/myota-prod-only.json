{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListImportsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-imports"
      ]
    },
    {
      "Sid": "ReadWriteImportsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-imports/*"
      ]
    },
    {
      "Sid": "ListContentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-content"
      ]
    },
    {
      "Sid": "ReadWriteContentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-content/*"
      ]
    },
    {
      "Sid": "ListRecordsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-records"
      ]
    },
    {
      "Sid": "CertificatesWriteOnce",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-records/certificates/*"
      ]
    },
    {
      "Sid": "EvidenceReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::myota-prod-records/evidence/*"
      ]
    }
  ]
}
