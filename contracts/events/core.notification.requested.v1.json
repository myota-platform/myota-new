{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A notification was requested",
  "description": "Published by any service that needs to tell a person something. `core` is the only sender, so there is one ledger, one retry policy and one dead-letter path rather than six tables in two databases. `template` is an allowlisted id, never caller-supplied body text.",
  "allOf": [
    {
      "$ref": "v1.schema.json"
    },
    {
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^/(core|geodata|activity)$",
          "description": "The service that needs someone told. The type is namespaced `core.` because core owns the notification domain and is the only sender, but any service may raise the request — so the producer varies and `source` is a pattern rather than a constant."
        },
        "type": {
          "const": "core.notification.requested.v1"
        },
        "data": {
          "type": "object",
          "required": [
            "notificationId",
            "accountId",
            "template",
            "channel"
          ],
          "additionalProperties": false,
          "properties": {
            "notificationId": {
              "type": "string",
              "format": "uuid"
            },
            "accountId": {
              "type": "string",
              "format": "uuid"
            },
            "template": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.v[0-9]+)$",
              "examples": [
                "account-verify.v1"
              ]
            },
            "channel": {
              "type": "string",
              "enum": [
                "email",
                "in_app"
              ]
            },
            "payload": {
              "type": "object"
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "specversion": "1.0",
      "id": "018f3c1e-0000-4000-8000-000000000001",
      "source": "/core",
      "type": "core.notification.requested.v1",
      "subject": "account:44a1b7c2-0d3e-4f51-9a86-2c7d1e5f0a93",
      "time": "2026-11-27T09:00:00Z",
      "datacontenttype": "application/json",
      "data": {
        "notificationId": "6c9d3a52-4e1b-4a07-8f2d-5b3e9c1a7d84",
        "accountId": "44a1b7c2-0d3e-4f51-9a86-2c7d1e5f0a93",
        "template": "account-verify.v1",
        "channel": "email",
        "payload": {
          "verifyUrl": "https://myota-test.ea7klk.es/verify?token=…"
        }
      }
    }
  ]
}
